msgid "Let §0 be an object in the universe §1, and let §2 be a set whose elements\n"
"come from §3.  Suppose that §4.  Then §5."
msgstr ""

#: Game.Levels.FamUnion.L06unionsub
msgid "Union subset of a set"
msgstr ""

