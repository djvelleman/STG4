#: Game.Levels.FamUnion.L01proveexists
msgid "§0 is a proof of the goal, so §1\n"
"will close the goal."
msgstr ""

#: Game.Levels.FamUnion.L07eltwiseinter
msgid "Union of a family of intersections"
msgstr ""

